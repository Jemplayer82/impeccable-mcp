# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Required. Bearer token clients must send as `Authorization: Bearer <token>`.
# The server refuses to start without this set. Generate with:
#   openssl rand -hex 32
IMPECCABLE_MCP_TOKEN=changeme

# Port the MCP server listens on inside the container.
PORT=8000

# Set to "1" to allow scan_url / screenshot to target RFC1918, loopback, or
# link-local addresses. Leave unset in normal operation — this exists so a
# prompt-injected agent can't turn this service into a LAN port scanner or
# point it at Portainer/HA from inside the trusted network.
IMPECCABLE_ALLOW_PRIVATE=

# Max concurrent browser-backed scans (scan_url, screenshot). Static-path
# tools (scan_html, list_rules) are not gated by this.
MAX_CONCURRENCY=2

# Close the idle Chromium instance after this many ms with no scans. It
# relaunches lazily on the next request.
BROWSER_IDLE_TIMEOUT_MS=300000
